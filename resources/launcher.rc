#include <windows.h>
#include <commctrl.h>

// Icon
1                       ICON                    "resources/app.ico"

// Manifest
1                       RT_MANIFEST             "resources/app.manifest"

// Embedded Portable Payload
2001                    RCDATA                  "dist/Gemini-Portable.zip"

// Version Information
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Gemini Desktop Project"
            VALUE "FileDescription", "Google Gemini Desktop Assistant (Single-File Standalone)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "GeminiPortable"
            VALUE "LegalCopyright", "Copyright (C) 2026 Gemini Desktop Project. All rights reserved."
            VALUE "OriginalFilename", "Gemini_Portable.exe"
            VALUE "ProductName", "Google Gemini Desktop Assistant"
            VALUE "ProductVersion", "1.0.0.0"
            VALUE "Comments", "All-in-One Standalone Portable Executable for Windows"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
